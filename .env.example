# --- Supabase (safe to expose to the browser) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (never NEXT_PUBLIC) --------------------------------
# Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=
# Enables AI-synthesized account briefs; template fallback runs without it
ANTHROPIC_API_KEY=
# Resend for TAM approval emails; without it the app runs EMAIL_MODE=log
RESEND_API_KEY=
# log | send  (log writes the full email to the server console — great for testing)
EMAIL_MODE=log
# Verified sender once Resend has your domain, e.g. "Handoff Portal <portal@gocanvas.com>"
EMAIL_FROM=
# Signs the one-click approve/decline links. Generate: openssl rand -base64 32
TAM_TOKEN_SECRET=
# Public base URL of the deployed app (used in email links)
APP_URL=http://localhost:3000

# --- App configuration ------------------------------------------------------
# Client-side signup hint; the database trigger is the real enforcement
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=gocanvas.com
# Flip to "true" only after IT approves the Entra app registration and the
# Azure provider is configured in Supabase Auth (see README "Enabling Microsoft SSO")
NEXT_PUBLIC_AUTH_MICROSOFT_ENABLED=false
