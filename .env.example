# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Dashboard -> Project Settings -> API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Server secrets ----------------------------------------------------------
# AI-synthesized account briefs (template fallback runs without it)
ANTHROPIC_API_KEY=
# Email delivery via Resend; without it EMAIL_MODE=log prints emails to the log
RESEND_API_KEY=
EMAIL_MODE=log
EMAIL_FROM=
# Signs TAM approve/decline links and journey tracked links: openssl rand -base64 32
TAM_TOKEN_SECRET=
# Protects /api/cron/* endpoints: openssl rand -base64 32 (set the same value in Vercel cron headers config if used externally)
CRON_SECRET=
# Signs the gc_plan session cookie for external plan links (/plan/$token):
# openssl rand -base64 32. Rotating it only signs viewers out — they click
# their link again. Required before external_plan_view_enabled is flipped on.
PLAN_SESSION_SECRET=
# Public base URL used inside emailed links
APP_URL=http://localhost:3000

# --- App configuration -------------------------------------------------------
# Signup form hint; authoritative enforcement is the database trigger
VITE_ALLOWED_EMAIL_DOMAINS=gocanvas.com
# Flip to "true" after IT approves the Entra app + Azure provider is configured in Supabase
VITE_AUTH_MICROSOFT_ENABLED=false
